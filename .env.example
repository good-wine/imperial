# --- general / tradecraft ---
LOG_LEVEL=INFO
MAX_FILE_MB=500
WORK_DIR=/tmp/opencode/provenance
REPORT_OUT_DIR=reports
TLP_MARKING=TLP:CLEAR
AUDIT_LOG=reports/audit.jsonl

# --- persistence / async ---
DATABASE_URL=
# e.g. postgresql://prov:prov@localhost:5432/provenance (empty = local sqlite)
CELERY_BROKER_URL=redis://localhost:6379/0
POSTGRES_USER=prov
POSTGRES_PASSWORD=prov
POSTGRES_DB=provenance
# At-rest field encryption (Fernet key, classified deployments only):
CASES_FERNET_KEY=

# --- supply chain ---
MODEL_ED25519_PUBKEY=
MODEL_SIG_ENFORCE=0

# --- forensics ---
MAX_FRAMES=5
ONNX_MODEL_PATH=models/deepfake.onnx
SYNTHETIC_MODEL_PATH=models/synthetic_clip.onnx
CLIP_MODEL_PATH=models/clip_image.onnx
MODEL_REGISTRY_PATH=models/registry.json
ENABLE_HEATMAP=0
FORCE_CPU=0
TRUST_ANCHORS_PATH=config/trust_anchors.json

# --- context / vector backends: memory | postgres | milvus | weaviate ---
QDRANT_URL=http://localhost:6333
VECTOR_BACKEND=memory
PHASH_THRESHOLD=8
PDQ_THRESHOLD=48
CLIP_THRESHOLD=0.90
REFERENCE_DB_PATH=data/reference_events.json
POSTGRES_DSN=postgresql://prov:prov@localhost:5432/provenance
MILVUS_URI=http://localhost:19530
WEAVIATE_URL=http://localhost:8080

# --- LLM: auto | ollama | jury | hf | llamaindex | rule-based ---
LLM_BACKEND=auto
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_S=60
HF_MODEL=TinyLlama/TinyLlama-1.1B-Chat-v1.0
RAG_TOP_K=3

# --- speech (Whisper, offline after provisioning) ---
WHISPER_MODEL=tiny
WHISPER_ROOT=models/whisper

# --- OSINT ingestion (unvetted OSINT defaults to TLP:AMBER) ---
OSINT_RSS_FEEDS=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
TELEGRAM_USE_TELETHON=0

# --- active learning ---
AL_RETRAIN_THRESHOLD=50

# --- SSO (optional; empty = callsign mode) ---
OIDC_ISSUER=
OIDC_AUDIENCE=api
OIDC_CLIENT_ID=dashboard
OIDC_CLIENT_SECRET=
OAUTH2_COOKIE_SECRET=
KC_ADMIN=admin
KC_ADMIN_PASSWORD=change-me

# --- retention (days per TLP; RED never auto-purges) ---
RETENTION_DAYS_CLEAR=30
RETENTION_DAYS_GREEN=90
RETENTION_DAYS_AMBER=365

# --- serving ---
API_HOST=127.0.0.1
API_PORT=8088
API_BASE=http://127.0.0.1:8000
TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
