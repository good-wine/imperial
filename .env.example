# --- general / tradecraft ---
LOG_LEVEL=INFO
MAX_FILE_MB=500
WORK_DIR=/tmp/opencode/provenance
REPORT_OUT_DIR=reports
TLP_MARKING=TLP:CLEAR
AUDIT_LOG=reports/audit.jsonl

# --- persistence / async ---
DATABASE_URL=
# e.g. postgresql://prov:prov@localhost:5432/provenance (empty = local sqlite)
CELERY_BROKER_URL=redis://localhost:6379/0
POSTGRES_USER=prov
POSTGRES_PASSWORD=prov
POSTGRES_DB=provenance
# At-rest field encryption (Fernet key, classified deployments only):
CASES_FERNET_KEY=

# --- supply chain ---
MODEL_ED25519_PUBKEY=
MODEL_SIG_ENFORCE=0

# --- forensics ---
MAX_FRAMES=5
ONNX_MODEL_PATH=models/deepfake.onnx
SYNTHETIC_MODEL_PATH=models/synthetic_clip.onnx
CLIP_MODEL_PATH=models/clip_image.onnx
# ImageBind ViT-Huge vision tower (1024-d joint space). Needs the 2.4 GB
# models/imagebind_vision.onnx.data beside the .onnx; set to 0 to skip loading
# it (semantic tier falls back to CLIP-512 + hashes).
IMAGEBIND_MODEL_PATH=models/imagebind_vision.onnx
IMAGEBIND_ENABLED=1
# ImageBind's similarity scale is lower than CLIP's (measured mean true cosine
# 0.854 vs 0.891 on scripts/eval_decontextualization.py), so the joint-space
# tier gets its own gate instead of being judged by CLIP's.
IB_THRESHOLD=0.85
# Stale-claim watchdog: a case untouched for this long while queued/running is
# re-dispatched (evidence present) or failed (evidence gone). Beat runs it
# every 5 min. Raise it if analysis legitimately takes longer than this.
STALE_CASE_SECONDS=900
MODEL_REGISTRY_PATH=models/registry.json
ENABLE_HEATMAP=0
FORCE_CPU=0
TRUST_ANCHORS_PATH=config/trust_anchors.json

# --- context / vector backends: memory | postgres | milvus | weaviate ---
QDRANT_URL=http://localhost:6333
VECTOR_BACKEND=memory
PHASH_THRESHOLD=8
PDQ_THRESHOLD=48
CLIP_THRESHOLD=0.90
REFERENCE_DB_PATH=data/reference_events.json
POSTGRES_DSN=postgresql://prov:prov@localhost:5432/provenance
MILVUS_URI=http://localhost:19530
WEAVIATE_URL=http://localhost:8080

# --- LLM: auto | ollama | jury | hf | llamaindex | rule-based ---
LLM_BACKEND=auto
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_S=60
HF_MODEL=TinyLlama/TinyLlama-1.1B-Chat-v1.0
RAG_TOP_K=3

# --- speech (Whisper, offline after provisioning) ---
WHISPER_MODEL=tiny
WHISPER_ROOT=models/whisper

# --- OSINT ingestion (unvetted OSINT defaults to TLP:AMBER) ---
OSINT_RSS_FEEDS=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
TELEGRAM_USE_TELETHON=0

# --- active learning ---
AL_RETRAIN_THRESHOLD=50

# --- EU AI Act Art. 50 operator posture (declared, never inferred) ---
# role: provider | deployer | both. An unknown value fails closed to deployer.
# A carve-out is a legal act, so it is a deliberate config change, never a
# code default; an unset deployment over-complies instead of claiming one.
AI_ACT_ROLE=deployer
AI_ACT_LAW_ENFORCEMENT=0
AI_ACT_STANDARD_EDITING=0

# --- SSO (optional; empty = callsign mode) ---
OIDC_ISSUER=
OIDC_AUDIENCE=api
OIDC_CLIENT_ID=dashboard
OIDC_CLIENT_SECRET=
OAUTH2_COOKIE_SECRET=
KC_ADMIN=admin
KC_ADMIN_PASSWORD=change-me
# Bind TLP clearance to identity (classified networks). When 1, a request's
# declared X-TLP/clearance is capped by the bearer token's `OIDC_TLP_CLAIM`
# value (fail-closed to TLP:CLEAR without a valid token). Off = callsign mode.
# Requires OIDC_AUDIENCE to be set (empty audience fails closed), else a token
# minted for another service at the same issuer would be accepted.
OIDC_BIND_CLEARANCE=0
OIDC_TLP_CLAIM=tlp_clearance
# With OIDC_ISSUER set, requests must carry a valid bearer; the self-declared
# owner/analyst fallback is only restored with this set to 1 (trusted lab only).
OIDC_ALLOW_ANONYMOUS=0

# --- retention (days per TLP; RED never auto-purges) ---
RETENTION_DAYS_CLEAR=30
RETENTION_DAYS_GREEN=90
RETENTION_DAYS_AMBER=365

# --- serving ---
API_HOST=127.0.0.1
API_PORT=8088
# Rate limits (per minute, per client IP): writes = ingestion budget; reads =
# larger budget for the console + compliance reads (each writes an audit row).
API_RATE_LIMIT_PER_MIN=30
API_RATE_LIMIT_READ_PER_MIN=240
TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu

# --- dashboard (analyst console) ---
DASHBOARD_LANG=en
API_BASE=http://127.0.0.1:8000
# Optional bearer so the console can read above TLP:CLEAR when
# OIDC_BIND_CLEARANCE=1 (the clearance selector is otherwise capped at CLEAR).
DASHBOARD_API_BEARER=
