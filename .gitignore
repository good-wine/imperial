# Python / virtualenvs
.venv/
venv/
__pycache__/
*.pyc
*.pyo
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# Secrets & local config (never commit)
.env
*.pem
*.key
config/model_signing/ed25519.sk
config/trust_anchors.local.json
config/imperial-root.crt

# Runtime state (recreated on boot)
data/*.db
data/*.db-journal
data/cases/
data/model_integrity.json
data/osint/
data/tg_session*
reports/*.report.json
reports/*.redacted.png
reports/*.report.md
reports/audit.jsonl
reports/sbom*.json
backups/
models/*.onnx
models/*.onnx.sig
# external tensor blob for models over the 2 GB protobuf limit (ImageBind)
models/*.onnx.data
models/*.pt
models/whisper/
*.log

# OS / editors
.DS_Store
.idea/
.vscode/
*.swp

# Rust build artifacts (crate is gated by CI's `rust` job, not by make gate)
rust/**/target/
rust/**/Cargo.lock
